# 复制为 .env 后填入密钥。示例通过 python-dotenv 加载。
# LiveKit Worker（examples 使用 agents.cli.run_app；console 模式不需要）
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 阿里云 DashScope：STT、LLM、TTS、Qwen Audio / Omni Realtime
DASHSCOPE_API_KEY=
# 默认 wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# qwen3.8-omni-flash-realtime 需要工作空间域名
DASHSCOPE_REALTIME_BASE_URL=
# 设为 1 时打印 Aliyun Realtime 收发事件
LK_ALIYUN_REALTIME_DEBUG=0
# livekit.plugins.aliyun.utils.get_base_url 的回退地址
# 默认 https://open.bigmodel.cn/api/paas/v4/
ZHIPU_LLM_BASE_URL=

# 火山引擎
VOLCENGINE_LLM_API_KEY=
# 默认 https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_LLM_BASE_URL=
VOLCENGINE_STT_APP_ID=
VOLCENGINE_STT_ACCESS_TOKEN=
VOLCENGINE_TTS_ACCESS_TOKEN=
# 默认 seed-tts-2.0
VOLCENGINE_TTS_RESOURCE_ID=
# Realtime 二选一：API Key，或同时提供 App ID 与 Access Token
VOLCENGINE_REALTIME_API_KEY=
VOLCENGINE_REALTIME_APP_ID=
VOLCENGINE_REALTIME_ACCESS_TOKEN=

# Dify
DIFY_API_KEY=
# 默认 https://api.dify.ai/v1
DIFY_API_BASE=
# 默认 test_user
DIFY_USER=

# FlashTTS
FLASHTTS_API_KEY=
# 默认 http://localhost:8000
FLASHTTS_BASE_URL=
