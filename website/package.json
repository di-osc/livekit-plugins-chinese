{
  "name": "livekit-plugins-chinese-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run site:export && npm run search:index",
    "site:export": "next build && npm run sitemap && next export",
    "search:clean": "node -e \"require('node:fs').rmSync('out/pagefind', { recursive: true, force: true })\"",
    "search:index": "npm run search:clean && pagefind --site out",
    "preview:search": "npm run build && node scripts/serve-search-preview.mjs",
    "sitemap": "next-sitemap --config next-sitemap.config.mjs",
    "start": "next start",
    "test": "jest",
    "lint": "next lint",
    "prettier": "prettier . --write"
  },
  "dependencies": {
    "@mdx-js/loader": "^2.1.5",
    "@mdx-js/react": "^2.1.5",
    "@next/mdx": "^13.0.2",
    "@types/node": "18.11.9",
    "@types/react": "18.0.25",
    "@types/react-dom": "18.0.8",
    "acorn": "^8.8.1",
    "browser-monads": "^1.0.0",
    "classnames": "^2.3.2",
    "eslint": "8.27.0",
    "eslint-config-next": "13.0.2",
    "html-to-react": "^1.5.0",
    "md-attr-parser": "^1.3.0",
    "next": "13.0.2",
    "next-mdx-remote": "^6.0.0",
    "next-pwa": "^5.6.0",
    "next-sitemap": "^3.1.32",
    "prettier": "^2.7.1",
    "prismjs": "^1.29.0",
    "prop-types": "^15.8.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-inlinesvg": "^3.0.1",
    "react-intersection-observer": "^9.4.0",
    "remark-gfm": "^4.0.1",
    "remark-smartypants": "^3.0.2",
    "sass": "^1.56.1",
    "typescript": "4.8.4",
    "unist-util-visit": "^4.1.1"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pagefind": "^1.5.2",
    "serve-handler": "6.1.7"
  }
}
